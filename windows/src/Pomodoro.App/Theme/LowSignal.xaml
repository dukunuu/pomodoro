<!--
  The "Low Signal" palette from ~/.config/ghostty/themes, so the app sits in
  the same visual register as the terminal. Ghostty runs window-theme = dark,
  so this app commits to dark and paints every surface explicitly.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Page and layer surfaces -->
            <Color x:Key="SolidBackgroundFillColorBase">#FF171C22</Color>
            <Color x:Key="SolidBackgroundFillColorSecondary">#FF1C222A</Color>
            <Color x:Key="SolidBackgroundFillColorTertiary">#FF20262E</Color>
            <Color x:Key="SolidBackgroundFillColorQuarternary">#FF20262E</Color>
            <Color x:Key="LayerFillColorDefault">#FF1C222A</Color>
            <Color x:Key="LayerFillColorAlt">#FF171C22</Color>
            <Color x:Key="CardBackgroundFillColorDefault">#FF1C222A</Color>
            <Color x:Key="CardBackgroundFillColorSecondary">#FF20262E</Color>
            <Color x:Key="CardStrokeColorDefault">#FF2B333D</Color>

            <!-- Controls: buttons, text boxes, combo boxes -->
            <Color x:Key="ControlFillColorDefault">#FF20262E</Color>
            <Color x:Key="ControlFillColorSecondary">#FF262D36</Color>
            <Color x:Key="ControlFillColorTertiary">#FF2B333D</Color>
            <Color x:Key="ControlFillColorDisabled">#FF1C222A</Color>
            <Color x:Key="ControlStrokeColorDefault">#FF2B333D</Color>
            <Color x:Key="ControlStrokeColorSecondary">#FF35464D</Color>
            <Color x:Key="ControlAltFillColorSecondary">#FF20262E</Color>
            <Color x:Key="ControlAltFillColorTertiary">#FF2B333D</Color>
            <Color x:Key="ControlAltFillColorQuarternary">#FF35464D</Color>
            <Color x:Key="ControlSolidFillColorDefault">#FF20262E</Color>

            <!-- Text -->
            <Color x:Key="TextFillColorPrimary">#FFEEE9DF</Color>
            <Color x:Key="TextFillColorSecondary">#FFD9D6CF</Color>
            <Color x:Key="TextFillColorTertiary">#FF73808C</Color>
            <Color x:Key="TextFillColorDisabled">#FF4A545E</Color>
            <Color x:Key="TextControlForeground">#FFD9D6CF</Color>
            <Color x:Key="TextControlPlaceholderForeground">#FF73808C</Color>

            <!-- Hover and pressed washes -->
            <Color x:Key="SubtleFillColorSecondary">#FF262D36</Color>
            <Color x:Key="SubtleFillColorTertiary">#FF2B333D</Color>

            <!-- Accent: the terminal's cursor colour, not Windows blue -->
            <Color x:Key="AccentFillColorDefault">#FFB88F76</Color>
            <Color x:Key="AccentFillColorSecondary">#FFA8836C</Color>
            <Color x:Key="AccentFillColorTertiary">#FF97775F</Color>
            <Color x:Key="AccentTextFillColorPrimary">#FFCBA68A</Color>
            <Color x:Key="AccentTextFillColorSecondary">#FFCBA68A</Color>
            <Color x:Key="TextOnAccentFillColorPrimary">#FF171C22</Color>
            <Color x:Key="TextOnAccentFillColorSelectedText">#FF171C22</Color>
            <Color x:Key="AccentFillColorDisabled">#FF3A3733</Color>

            <!-- Selection -->
            <Color x:Key="SystemColorHighlightColor">#FF35464D</Color>

            <!-- The system accent, which controls read before any of the
                 palette colours above. Without these an accent button stays
                 Windows blue no matter what AccentFillColor* say. -->
            <Color x:Key="SystemAccentColor">#FFB88F76</Color>
            <Color x:Key="SystemAccentColorLight1">#FFC49A82</Color>
            <Color x:Key="SystemAccentColorLight2">#FFCBA68A</Color>
            <Color x:Key="SystemAccentColorLight3">#FFD6B79E</Color>
            <Color x:Key="SystemAccentColorDark1">#FFA8836C</Color>
            <Color x:Key="SystemAccentColorDark2">#FF97775F</Color>
            <Color x:Key="SystemAccentColorDark3">#FF866A54</Color>

            <!-- Brushes as well as colours: WinUI's accent brushes are bound
                 to the system accent directly, so overriding only the colour
                 keys leaves them untouched. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFB88F76" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFA8836C" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF97775F" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF3A3733" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFCBA68A" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFCBA68A" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFB88F76" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF171C22" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FF20262E" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#FF73808C" />
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#FF97775F" />

            <!-- The progress track was reading as a bright line across the
                 card; it should sit just above the surface it lies on. -->
            <SolidColorBrush x:Key="ProgressBarTrackFill" Color="#FF2B333D" />
            <SolidColorBrush x:Key="ProgressBarBackground" Color="#FF2B333D" />
            <SolidColorBrush x:Key="ProgressBarBorderBrush" Color="Transparent" />

            <!-- ToggleSwitch reserves 154px so an On/Off label can sit beside
                 the track, and the reserve lives in the control's own default
                 style, where a per-instance MinWidth does not reach it. Every
                 switch in this app is label-less, so the reserve is cut to the
                 track and the switches sit at the trailing edge of their row. -->
            <x:Double x:Key="ToggleSwitchThemeMinWidth">40</x:Double>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Terminal roles, named as the theme file names them. -->
    <Color x:Key="LsBackground">#FF171C22</Color>
    <Color x:Key="LsForeground">#FFD9D6CF</Color>
    <Color x:Key="LsBrightForeground">#FFEEE9DF</Color>
    <Color x:Key="LsSelection">#FF35464D</Color>
    <Color x:Key="LsBlack">#FF20262E</Color>
    <Color x:Key="LsRed">#FFC0807E</Color>
    <Color x:Key="LsGreen">#FF91A58B</Color>
    <Color x:Key="LsYellow">#FFB88F76</Color>
    <Color x:Key="LsBlue">#FF849AAF</Color>
    <Color x:Key="LsMagenta">#FFA092B4</Color>
    <Color x:Key="LsCyan">#FF7FA6A2</Color>
    <Color x:Key="LsMuted">#FF73808C</Color>
    <Color x:Key="LsBrightRed">#FFD39893</Color>
    <Color x:Key="LsBrightYellow">#FFCBA68A</Color>

    <!-- Surfaces derived from the palette rather than system materials. -->
    <Color x:Key="LsSurface">#FF1C222A</Color>
    <Color x:Key="LsRaised">#FF20262E</Color>
    <Color x:Key="LsBorder">#FF2B333D</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource LsBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource LsSurface}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource LsRaised}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource LsBorder}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource LsForeground}" />
    <SolidColorBrush x:Key="TextBrightBrush" Color="{StaticResource LsBrightForeground}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource LsMuted}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource LsYellow}" />
    <SolidColorBrush x:Key="FocusBrightBrush" Color="{StaticResource LsBrightYellow}" />
    <SolidColorBrush x:Key="ShortBreakBrush" Color="{StaticResource LsBlue}" />
    <SolidColorBrush x:Key="LongBreakBrush" Color="{StaticResource LsGreen}" />
    <SolidColorBrush x:Key="UrgentBrush" Color="{StaticResource LsBrightRed}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource LsSelection}" />

    <!-- Card: flat, bordered, low contrast — the terminal register. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <Style x:Key="StatDetailStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style x:Key="ClockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextBrightBrush}" />
    </Style>
</ResourceDictionary>
