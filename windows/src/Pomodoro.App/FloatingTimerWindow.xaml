<Window
    x:Class="Pomodoro.App.FloatingTimerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- At rest this is the countdown and nothing else, on the acrylic the
         window itself provides. No frame of its own: the rounded corner and
         the hairline around it are the ones DWM draws, so the widget sits on
         the desktop the way the system's own flyouts do. -->
    <Border x:Name="Root" Background="#A61C222A"
            PointerPressed="OnDragStart"
            PointerEntered="OnPointerEntered"
            PointerExited="OnPointerExited">
        <!-- Window is not a FrameworkElement in WinUI, so it carries no
             resource dictionary; the overlay's one style lives here. It gives
             every control in the overlay the same shape: a round, unfilled
             target that only shows a fill under the pointer. -->
        <Border.Resources>
            <Style x:Key="OverlayButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Border.Resources>

        <Grid>
            <!-- The window is dragged through WM_NCLBUTTONDOWN from anywhere,
                 so the extended title bar is given a zero-sized drag region
                 rather than WinUI's default one, which would otherwise sit
                 over the top of the hover controls and swallow their clicks. -->
            <Border x:Name="DragRegion" Width="0" Height="0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" />

            <!-- Viewbox: the clock scales with the window, so resizing the
                 widget resizes the only thing it normally shows. -->
            <Viewbox Margin="14,10,14,13" Stretch="Uniform" StretchDirection="Both">
                <TextBlock x:Name="Clock" Text="25:00"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold" />
            </Viewbox>

            <!-- Phase progress as a hairline inset from the edges, rather than
                 a chrome bar welded to the bottom. -->
            <Grid Height="2" VerticalAlignment="Bottom" Margin="12,0,12,7">
                <Rectangle Fill="#1AFFFFFF" RadiusX="1" RadiusY="1" />
                <ProgressBar x:Name="PhaseProgress" Minimum="0" Maximum="1"
                             Height="2" Padding="0" CornerRadius="1"
                             Background="Transparent" BorderThickness="0" />
            </Grid>

            <Grid x:Name="Controls" Visibility="Collapsed" Background="#D90F141A">
                <StackPanel Orientation="Horizontal" Spacing="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ToggleButton" Click="OnToggle"
                            Style="{StaticResource OverlayButton}"
                            ToolTipService.ToolTip="Start or pause">
                        <FontIcon x:Name="ToggleGlyph" Glyph="&#xE768;" FontSize="15" />
                    </Button>
                    <Button Click="OnSkip" Style="{StaticResource OverlayButton}"
                            ToolTipService.ToolTip="Skip phase">
                        <FontIcon Glyph="&#xE893;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <Button Click="OnOpenDashboard" Style="{StaticResource OverlayButton}"
                            ToolTipService.ToolTip="Open dashboard">
                        <FontIcon Glyph="&#xE7C4;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <Button Click="OnHide" Style="{StaticResource OverlayButton}"
                            ToolTipService.ToolTip="Hide — bring it back from the tray">
                        <FontIcon Glyph="&#xE711;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </StackPanel>

                <!-- The window has no frame to grab, so the grip resizes it
                     directly. Shown only with the rest of the controls. -->
                <Border x:Name="ResizeGrip" Width="16" Height="16" Background="Transparent"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        PointerPressed="OnResizeStart"
                        PointerMoved="OnResizeMove"
                        PointerReleased="OnResizeEnd"
                        PointerCaptureLost="OnResizeEnd"
                        ToolTipService.ToolTip="Drag to resize">
                    <Path Data="M 1,11 L 11,1 M 5,11 L 11,5" StrokeThickness="1"
                          Stroke="{ThemeResource TextFillColorTertiaryBrush}" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
