<Window
    x:Class="Pomodoro.App.FloatingTimerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- At rest this is the countdown and nothing else. The controls are an
         overlay that appears on hover, so the widget stays quiet until you
         reach for it. -->
    <Border x:Name="Root"
            Background="#8C141A21"
            BorderBrush="#26FFFFFF"
            BorderThickness="1" CornerRadius="10"
            PointerPressed="OnDragStart"
            PointerEntered="OnPointerEntered"
            PointerExited="OnPointerExited">
        <!-- Window is not a FrameworkElement in WinUI, so it carries no
             resource dictionary; the overlay's one style lives here. It gives
             every control in the overlay the same shape: a round, unfilled
             target that only shows a fill under the pointer. -->
        <Border.Resources>
            <Style x:Key="OverlayButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Border.Resources>

        <Grid>
            <!-- The window is dragged through WM_NCLBUTTONDOWN from anywhere,
                 so the extended title bar is given a zero-sized drag region
                 rather than WinUI's default one, which would otherwise sit
                 over the top of the hover controls and swallow their clicks. -->
            <Border x:Name="DragRegion" Width="0" Height="0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" />

            <!-- Viewbox: the clock scales with the window, so resizing the
                 widget resizes the only thing it normally shows. -->
            <Viewbox Margin="18,14,18,16" Stretch="Uniform" StretchDirection="Both">
                <TextBlock x:Name="Clock" Text="25:00"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontWeight="SemiBold" />
            </Viewbox>

            <!-- Phase progress as a hairline inset from the edges, rather than
                 a chrome bar welded to the bottom. -->
            <Grid Height="2" VerticalAlignment="Bottom" Margin="14,0,14,9">
                <Rectangle Fill="#1FFFFFFF" RadiusX="1" RadiusY="1" />
                <ProgressBar x:Name="PhaseProgress" Minimum="0" Maximum="1"
                             Height="2" Padding="0" CornerRadius="1"
                             Background="Transparent" BorderThickness="0" />
            </Grid>

            <Grid x:Name="Controls" Visibility="Collapsed"
                  Background="#E60F141A" CornerRadius="9">
                <StackPanel Orientation="Horizontal" Spacing="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="ToggleButton" Click="OnToggle"
                            Style="{StaticResource OverlayButton}"
                            ToolTipService.ToolTip="Start or pause">
                        <FontIcon x:Name="ToggleGlyph" Glyph="&#xE768;" FontSize="15" />
                    </Button>
                    <Button Click="OnSkip" Style="{StaticResource OverlayButton}"
                            ToolTipService.ToolTip="Skip phase">
                        <FontIcon Glyph="&#xE893;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <Button Click="OnOpenDashboard" Style="{StaticResource OverlayButton}"
                            ToolTipService.ToolTip="Open dashboard">
                        <FontIcon Glyph="&#xE7C4;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                    <Button Click="OnHide" Style="{StaticResource OverlayButton}"
                            ToolTipService.ToolTip="Hide — bring it back from the tray">
                        <FontIcon Glyph="&#xE711;" FontSize="13"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
