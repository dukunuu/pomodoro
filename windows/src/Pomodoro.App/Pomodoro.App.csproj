<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pomodoro.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged: a plain exe an Inno Setup installer can lay down, rather
         than an MSIX. WindowsAppSDKSelfContained means no runtime install. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationIcon>Assets\pomodoro.ico</ApplicationIcon>
    <AssemblyName>Pomodoro</AssemblyName>
    <!-- WindowsAppSDK ships ~100 localized .mui sets; shipping only English
         cuts roughly 20MB from the artifact. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- XAML generated code trips analyzers we cannot edit. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the build CI resolved, so restores are reproducible. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pomodoro.Core\Pomodoro.Core.csproj" />
  </ItemGroup>
</Project>
