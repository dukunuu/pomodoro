<Window
    x:Class="Pomodoro.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Pinned timer: the app is the timer, every panel below is a report
             about it, so it never scrolls away. -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1"
                Padding="18,14">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="PhaseDot" Width="8" Height="8"
                                 Fill="{StaticResource FocusBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PhaseLabel" Text="Focus" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrightBrush}" />
                        <TextBlock x:Name="StatusLabel" Text="Ready" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="Clock" Text="25:00" Style="{StaticResource ClockStyle}" />
                    <StackPanel x:Name="CycleDots" Orientation="Horizontal" Spacing="4" Margin="0,2,0,0" />
                </StackPanel>

                <ProgressBar Grid.Column="1" x:Name="PhaseProgress" VerticalAlignment="Center"
                             Height="4" Minimum="0" Maximum="1"
                             Background="{StaticResource RaisedBrush}"
                             Foreground="{StaticResource FocusBrush}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="ToggleButton" Content="Start" Click="OnToggle" MinWidth="82" />
                    <Button Content="Skip" Click="OnSkip" />
                    <Button Content="Reset" Click="OnReset" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView Grid.Row="1" x:Name="Nav" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" PaneDisplayMode="Left"
                        OpenPaneLength="180" IsPaneToggleButtonVisible="False"
                        SelectionChanged="OnSectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Today" Tag="today" IsSelected="True" />
                <NavigationViewItem Content="Week" Tag="week" />
                <NavigationViewItem Content="Month" Tag="month" />
                <NavigationViewItem Content="All time" Tag="all" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Whistler" Tag="whistler" />
                <NavigationViewItem Content="Settings" Tag="settings" />
            </NavigationView.MenuItems>

            <ScrollViewer Padding="16">
                <StackPanel Spacing="14">
                    <Border x:Name="UpdateBanner" Visibility="Collapsed" CornerRadius="10"
                            Padding="12" BorderThickness="1"
                            BorderBrush="{StaticResource FocusBrush}"
                            Background="{StaticResource RaisedBrush}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="1">
                                <TextBlock x:Name="UpdateTitle" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource TextBrightBrush}" />
                                <TextBlock x:Name="UpdateSubtitle" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Download" Click="OnDownloadUpdate"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Grid.Column="2" Content="Release notes" Click="OnOpenReleaseNotes" />
                        </Grid>
                    </Border>

                    <Grid>
                    <!-- Today -->
                    <StackPanel x:Name="TodayPanel" Spacing="14">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="FOCUS" Style="{StaticResource StatLabelStyle}" />
                                    <TextBlock x:Name="FocusValue" Text="0m" Style="{StaticResource StatValueStyle}"
                                               Foreground="{StaticResource FocusBrightBrush}" />
                                    <TextBlock Text="active time" Style="{StaticResource StatDetailStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="BREAKS" Style="{StaticResource StatLabelStyle}" />
                                    <TextBlock x:Name="BreakValue" Text="0m" Style="{StaticResource StatValueStyle}" />
                                    <TextBlock x:Name="BreakDetail" Text="0 taken" Style="{StaticResource StatDetailStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Text="SESSIONS" Style="{StaticResource StatLabelStyle}" />
                                    <TextBlock x:Name="SessionsValue" Text="0" Style="{StaticResource StatValueStyle}"
                                               Foreground="{StaticResource FocusBrightBrush}" />
                                    <TextBlock Text="completed" Style="{StaticResource StatDetailStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <TextBlock Text="PHASES" Style="{StaticResource StatLabelStyle}" />
                                    <TextBlock x:Name="PhasesValue" Text="0" Style="{StaticResource StatValueStyle}" />
                                    <TextBlock Text="recorded" Style="{StaticResource StatDetailStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="WHAT ARE YOU FOCUSING ON?" Style="{StaticResource CardTitleStyle}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="NoteBox"
                                             PlaceholderText="Add a note for this session" />
                                    <Button Grid.Column="1" Content="Save" Click="OnSaveNote" />
                                </Grid>
                                <TextBlock Text="Saved with the session when this focus phase ends."
                                           Style="{StaticResource StatDetailStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="DayLabel" Text="TODAY" Style="{StaticResource CardTitleStyle}" />
                                <StackPanel x:Name="PhaseList" Spacing="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Week / Month / All time share a heading and a rows panel -->
                    <StackPanel x:Name="ReportPanel" Spacing="14" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock x:Name="ReportTitle" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrightBrush}" />
                                        <TextBlock x:Name="ReportSubtitle" FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button x:Name="ReportBack" Content="&#xE76B;"
                                                FontFamily="Segoe MDL2 Assets" Click="OnReportBack" />
                                        <Button x:Name="ReportToday" Content="Today" Click="OnReportToday" />
                                        <Button x:Name="ReportForward" Content="&#xE76C;"
                                                FontFamily="Segoe MDL2 Assets" Click="OnReportForward" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel x:Name="ReportRows" Spacing="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Whistler -->
                    <StackPanel x:Name="WhistlerPanel" Spacing="14" Visibility="Collapsed">
                        <Border x:Name="SetupCard" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="SETUP" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Whistler needs a Google Calendar client, an authorized Google account, and your Whistler credentials." />
                                <StackPanel x:Name="SetupRows" Spacing="6" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="SEND TO WHISTLER" Style="{StaticResource CardTitleStyle}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CalendarDatePicker Grid.Column="0" x:Name="SendDate" MinWidth="150"
                                                        DateChanged="OnSendDateChanged" />
                                    <Button Grid.Column="2" x:Name="SendButton" Content="Send today"
                                            Click="OnSend" Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                                <ProgressBar x:Name="SendProgress" Minimum="0" Maximum="100"
                                             Visibility="Collapsed"
                                             Background="{StaticResource RaisedBrush}"
                                             Foreground="{StaticResource FocusBrush}" />
                                <TextBlock x:Name="SendStatus" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Reads that day's Google Calendar events, classifies them, and writes the worklog." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="AI MAPPING INSTRUCTIONS" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Added to the OpenRouter prompt for every event. Use it to map calendar wording onto Whistler projects." />
                                <TextBox x:Name="InstructionsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="150" FontFamily="Cascadia Mono, Consolas" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save" Click="OnSaveInstructions" />
                                    <Button Content="Revert" Click="OnRevertInstructions" />
                                    <TextBlock x:Name="InstructionsSaved" Text="" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource LongBreakBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Settings -->
                    <StackPanel x:Name="SettingsPanel" Spacing="14" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="TIMER" Style="{StaticResource CardTitleStyle}" />
                                <Grid ColumnSpacing="14" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Focus"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <NumberBox Grid.Row="0" Grid.Column="1" x:Name="FocusMinutes" Minimum="1"
                                               Maximum="240" SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnPreferenceChanged" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Short break"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <NumberBox Grid.Row="1" Grid.Column="1" x:Name="ShortMinutes" Minimum="1"
                                               Maximum="240" SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnPreferenceChanged" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Long break"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <NumberBox Grid.Row="2" Grid.Column="1" x:Name="LongMinutes" Minimum="1"
                                               Maximum="240" SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnPreferenceChanged" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Long break every"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <NumberBox Grid.Row="3" Grid.Column="1" x:Name="LongEvery" Minimum="1"
                                               Maximum="12" SpinButtonPlacementMode="Compact"
                                               ValueChanged="OnPreferenceChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="BEHAVIOR" Style="{StaticResource CardTitleStyle}" />
                                <ToggleSwitch x:Name="FloatingToggle" Header="Floating timer window"
                                              Toggled="OnPreferenceToggled" />
                                <ToggleSwitch x:Name="TrayCountdownToggle" Header="Countdown in the tray tooltip"
                                              Toggled="OnPreferenceToggled" />
                                <ToggleSwitch x:Name="AlarmToggle" Header="Sound when a phase ends"
                                              Toggled="OnPreferenceToggled" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="UPDATES" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="VersionText" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <ToggleSwitch x:Name="UpdateCheckToggle"
                                              Header="Check GitHub for new releases on launch"
                                              Toggled="OnUpdatePreferenceToggled" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CheckUpdatesButton" Content="Check now"
                                            Click="OnCheckForUpdates" />
                                    <TextBlock x:Name="UpdateStatus" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="Once a day at most. Nothing is downloaded or installed automatically." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="DATA" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="DataPathText" FontSize="12" IsTextSelectionEnabled="True"
                                           TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" />
                                <Button Content="Open data folder" Click="OnOpenDataFolder" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
