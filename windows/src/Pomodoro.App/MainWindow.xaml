<Window
    x:Class="Pomodoro.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Content extends into the title bar, so the app owns the whole
             window the way a Windows 11 app does. This strip is the drag
             region; the caption buttons sit to its right. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/pomodoro.ico" Width="16" Height="16" />
                <TextBlock Text="Pomodoro" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1" x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        IsPaneToggleButtonVisible="True"
                        SelectionChanged="OnSectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Today" Tag="today" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE916;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Week" Tag="week">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Month" Tag="month">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BF;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="All time" Tag="all">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Whistler" Tag="whistler">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hero: the timer is the app, so it stays put while the
                     sections below scroll under it. -->
                <Border Grid.Row="0" Margin="24,8,24,0" Style="{StaticResource Card}"
                        Padding="20,16">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="PhasePill" CornerRadius="10" Padding="10,3"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock x:Name="PhaseLabel" Text="FOCUS" FontSize="10"
                                               FontWeight="SemiBold" CharacterSpacing="70"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock x:Name="StatusLabel" Text="Ready" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock x:Name="Clock" Text="25:00" Style="{StaticResource Clock}" />

                            <StackPanel x:Name="CycleDots" Orientation="Horizontal" Spacing="5"
                                        VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"
                                    Margin="0,0,0,4">
                            <ProgressBar x:Name="PhaseProgress" Height="6" Minimum="0" Maximum="1"
                                         CornerRadius="3" />
                            <TextBlock x:Name="PhaseCaption" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button x:Name="ToggleButton" Click="OnToggle" MinWidth="104"
                                    Style="{ThemeResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="ToggleGlyph" Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock x:Name="ToggleText" Text="Start" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnSkip" ToolTipService.ToolTip="Skip phase">
                                <FontIcon Glyph="&#xE893;" FontSize="14" />
                            </Button>
                            <Button Click="OnReset" ToolTipService.ToolTip="Reset phase">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="{StaticResource PagePadding}">
                    <Grid>
                        <!-- Today -->
                        <StackPanel x:Name="TodayPanel" Spacing="8">
                            <TextBlock Text="Today" Style="{StaticResource SectionHeader}" />
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="FOCUS" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="FocusValue" Text="0m"
                                                   Style="{StaticResource StatValue}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="active time" Style="{StaticResource StatDetail}" />
                                    </StackPanel>
                                    <Rectangle Grid.Column="1" Width="1" Margin="0,4"
                                               Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="BREAKS" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="BreakValue" Text="0m" Style="{StaticResource StatValue}" />
                                        <TextBlock x:Name="BreakDetail" Text="0 taken" Style="{StaticResource StatDetail}" />
                                    </StackPanel>
                                    <Rectangle Grid.Column="3" Width="1" Margin="0,4"
                                               Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <StackPanel Grid.Column="4" Spacing="2">
                                        <TextBlock Text="SESSIONS" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="SessionsValue" Text="0"
                                                   Style="{StaticResource StatValue}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="completed" Style="{StaticResource StatDetail}" />
                                    </StackPanel>
                                    <Rectangle Grid.Column="5" Width="1" Margin="0,4"
                                               Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <StackPanel Grid.Column="6" Spacing="2">
                                        <TextBlock Text="PHASES" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="PhasesValue" Text="0" Style="{StaticResource StatValue}" />
                                        <TextBlock Text="recorded" Style="{StaticResource StatDetail}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE70F;" Style="{StaticResource RowGlyph}" />
                                    <TextBox Grid.Column="1" x:Name="NoteBox"
                                             PlaceholderText="What are you focusing on?"
                                             BorderThickness="0" Background="Transparent" />
                                    <Button Grid.Column="2" Content="Save" Click="OnSaveNote" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="DayLabel" Text="Today"
                                       Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                            <Border Style="{StaticResource Card}" Padding="8,4">
                                <StackPanel x:Name="PhaseList" Spacing="0" />
                            </Border>
                        </StackPanel>

                        <!-- Week / Month / All time -->
                        <StackPanel x:Name="ReportPanel" Spacing="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock x:Name="ReportTitle" Style="{StaticResource SectionHeader}" />
                                    <TextBlock x:Name="ReportSubtitle" Style="{StaticResource RowDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="ReportBack" Click="OnReportBack"
                                            ToolTipService.ToolTip="Previous">
                                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                                    </Button>
                                    <Button x:Name="ReportToday" Content="Today" Click="OnReportToday" />
                                    <Button x:Name="ReportForward" Click="OnReportForward"
                                            ToolTipService.ToolTip="Next">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Card}" Padding="8,4">
                                <StackPanel x:Name="ReportRows" Spacing="0" />
                            </Border>
                        </StackPanel>

                        <!-- Whistler -->
                        <StackPanel x:Name="WhistlerPanel" Spacing="8" Visibility="Collapsed">
                            <InfoBar x:Name="SetupBar" IsOpen="False" IsClosable="False"
                                     Severity="Warning"
                                     Title="Setup incomplete"
                                     Message="Whistler needs a Google Calendar client, an authorized Google account, and your Whistler credentials." />

                            <StackPanel x:Name="SetupRows" Spacing="6" />

                            <!-- Setup results belong beside the setup buttons.
                                 Reporting them in SendBar, three cards further
                                 down, made a failed authorization look like a
                                 button that did nothing. -->
                            <InfoBar x:Name="SetupResultBar" IsOpen="False" IsClosable="True"
                                     Severity="Informational" />

                            <TextBlock Text="Send" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />
                            <Border Style="{StaticResource SettingsRow}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE724;" Style="{StaticResource RowGlyph}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="Send a day to Whistler" Style="{StaticResource RowTitle}" />
                                            <TextBlock Style="{StaticResource RowDescription}"
                                                       Text="Reads that day's Calendar events, classifies them, and writes the worklog." />
                                        </StackPanel>
                                        <CalendarDatePicker Grid.Column="2" x:Name="SendDate" MinWidth="150"
                                                            DateChanged="OnSendDateChanged"
                                                            VerticalAlignment="Center" />
                                        <Button Grid.Column="3" x:Name="SendButton" Content="Send"
                                                Click="OnSend" MinWidth="90"
                                                VerticalAlignment="Center"
                                                Style="{ThemeResource AccentButtonStyle}" />
                                    </Grid>
                                    <ProgressBar x:Name="SendProgress" Minimum="0" Maximum="100"
                                                 Visibility="Collapsed" CornerRadius="2" />
                                    <InfoBar x:Name="SendBar" IsOpen="False" IsClosable="True"
                                             Severity="Informational" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Month coverage" Style="{StaticResource SectionHeader}"
                                       Margin="2,10,0,0" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="MonthStatusText"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource RowDescription}"
                                                   Text="Refresh to compare Google Calendar against Whistler for this month." />
                                        <Button Grid.Column="1" x:Name="RefreshMonthButton"
                                                Click="OnRefreshMonth">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                <TextBlock Text="Refresh" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <StackPanel x:Name="MonthSummary" Visibility="Collapsed" Spacing="12">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="TARGET" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="MonthTarget" Style="{StaticResource StatValue}" />
                                                <TextBlock x:Name="MonthTargetDetail" Style="{StaticResource StatDetail}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="LOGGED" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="MonthLogged" Style="{StaticResource StatValue}"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="MonthLoggedDetail" Style="{StaticResource StatDetail}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="TO DATE" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="MonthToDate" Style="{StaticResource StatValue}" />
                                                <TextBlock x:Name="MonthToDateDetail" Style="{StaticResource StatDetail}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="2">
                                                <TextBlock Text="BALANCE" Style="{StaticResource StatLabel}" />
                                                <TextBlock x:Name="MonthBalance" Style="{StaticResource StatValue}" />
                                                <TextBlock x:Name="MonthBalanceDetail" Style="{StaticResource StatDetail}" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar x:Name="MonthProgress" Minimum="0" Maximum="1"
                                                     Height="6" CornerRadius="3" />
                                        <StackPanel x:Name="MonthProjects" Spacing="6" />
                                        <StackPanel x:Name="MonthDays" Spacing="2" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="AI mapping instructions" Style="{StaticResource SectionHeader}"
                                       Margin="2,10,0,0" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource RowDescription}"
                                               Text="Added to the OpenRouter prompt for every event. Use it to map calendar wording onto Whistler projects." />
                                    <TextBox x:Name="InstructionsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="150" FontFamily="Cascadia Mono, Consolas" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Save" Click="OnSaveInstructions"
                                                Style="{ThemeResource AccentButtonStyle}" />
                                        <Button Content="Revert" Click="OnRevertInstructions" />
                                        <TextBlock x:Name="InstructionsSaved" Text="" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Settings -->
                        <StackPanel x:Name="SettingsPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Timer" Style="{StaticResource SectionHeader}" />

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE916;" Style="{StaticResource RowGlyph}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Focus length" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Minutes per focus phase" Style="{StaticResource RowDescription}" />
                                    </StackPanel>
                                    <NumberBox Grid.Column="2" x:Name="FocusMinutes" Minimum="1" Maximum="240"
                                               SpinButtonPlacementMode="Compact" MinWidth="120"
                                               VerticalAlignment="Center" ValueChanged="OnPreferenceChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7F4;" Style="{StaticResource RowGlyph}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Short break" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Minutes after each focus phase" Style="{StaticResource RowDescription}" />
                                    </StackPanel>
                                    <NumberBox Grid.Column="2" x:Name="ShortMinutes" Minimum="1" Maximum="240"
                                               SpinButtonPlacementMode="Compact" MinWidth="120"
                                               VerticalAlignment="Center" ValueChanged="OnPreferenceChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xEC32;" Style="{StaticResource RowGlyph}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Long break" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Minutes, taken every few focus phases" Style="{StaticResource RowDescription}" />
                                    </StackPanel>
                                    <NumberBox Grid.Column="2" x:Name="LongMinutes" Minimum="1" Maximum="240"
                                               SpinButtonPlacementMode="Compact" MinWidth="120"
                                               VerticalAlignment="Center" ValueChanged="OnPreferenceChanged" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8FD;" Style="{StaticResource RowGlyph}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Long break every" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Focus phases between long breaks" Style="{StaticResource RowDescription}" />
                                    </StackPanel>
                                    <NumberBox Grid.Column="2" x:Name="LongEvery" Minimum="1" Maximum="12"
                                               SpinButtonPlacementMode="Compact" MinWidth="120"
                                               VerticalAlignment="Center" ValueChanged="OnPreferenceChanged" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Behavior" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7C4;" Style="{StaticResource RowGlyph}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Floating timer" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="A small always-on-top window you can drag anywhere"
                                                   Style="{StaticResource RowDescription}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" x:Name="FloatingToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnPreferenceToggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7B3;" Style="{StaticResource RowGlyph}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Countdown in the tray" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Shows the remaining time in the notification area tooltip"
                                                   Style="{StaticResource RowDescription}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" x:Name="TrayCountdownToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnPreferenceToggled" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE767;" Style="{StaticResource RowGlyph}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Sound when a phase ends" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="Plays alongside the notification"
                                                   Style="{StaticResource RowDescription}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2" x:Name="AlarmToggle" OnContent="" OffContent=""
                                                  VerticalAlignment="Center" Toggled="OnPreferenceToggled" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE895;" Style="{StaticResource RowGlyph}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                                        <TextBlock x:Name="UpdateStatus"
                                                   Text="Checked at most once a day. Nothing installs automatically."
                                                   Style="{StaticResource RowDescription}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button x:Name="CheckUpdatesButton" Content="Check now"
                                                Click="OnCheckForUpdates" />
                                        <ToggleSwitch x:Name="UpdateCheckToggle" OnContent="" OffContent=""
                                                      Toggled="OnUpdatePreferenceToggled" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Data" Style="{StaticResource SectionHeader}" Margin="2,10,0,0" />

                            <Border Style="{StaticResource SettingsRow}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" Style="{StaticResource RowGlyph}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="Data folder" Style="{StaticResource RowTitle}" />
                                        <TextBlock x:Name="DataPathText" Style="{StaticResource RowDescription}"
                                                   IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Open" Click="OnOpenDataFolder"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- Sits above everything so a new release is noticed without
             interrupting whatever the user is doing. -->
        <InfoBar x:Name="UpdateBar" Grid.Row="1" IsOpen="False" IsClosable="True"
                 Severity="Success" VerticalAlignment="Bottom"
                 Margin="24,0,24,16" Title="Update available">
            <InfoBar.ActionButton>
                <Button Content="Update and restart" Click="OnDownloadUpdate" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
